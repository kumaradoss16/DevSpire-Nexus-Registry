{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devspirehub.com/schemas/common.schema.json",
  "title": "DevSpire Nexus Resource Common Contract",
  "description": "Base schema contract for all DevSpire Nexus registry records.",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "category",
    "resource_type",
    "official_url",
    "pricing",
    "license",
    "tags",
    "verified",
    "status",
    "evidence",
    "canonical_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique, stable, lowercase slug identifier."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Canonical human-readable resource name."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "Concise technical summary of capability and scope."
    },
    "category": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "Primary categorization within the registry domain."
    },
    "source_category": {
      "type": ["string", "null"],
      "description": "Original taxonomy classification before normalization."
    },
    "resource_type": {
      "type": "string",
      "description": "High-level functional archetype."
    },
    "official_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Primary canonical web URL or homepage."
    },
    "pricing": {
      "type": "string",
      "description": "Human-readable pricing tier (e.g. Open Source, Free, Freemium, Paid, Open Weights)."
    },
    "pricing_class": {
      "type": ["string", "null"],
      "description": "Normalized pricing taxonomy classification."
    },
    "license": {
      "type": ["string", "null"],
      "description": "Software or model license name."
    },
    "license_short": {
      "type": ["string", "null"],
      "description": "Abbreviated SPDX or conventional license identifier."
    },
    "open_source": {
      "type": ["boolean", "null"],
      "description": "Whether source code is available under an OSI-approved license."
    },
    "self_hostable": {
      "type": ["boolean", "null"],
      "description": "Whether the resource can be executed locally or on self-managed infrastructure."
    },
    "signup_required": {
      "type": ["boolean", "null"],
      "description": "Whether an account or registration is required for use."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Searchable technical keywords and tags."
    },
    "icon": {
      "type": ["string", "null"],
      "description": "Relative path to verified local brand/project icon asset."
    },
    "verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO-8601 date string (YYYY-MM-DD) of last verification."
    },
    "status": {
      "type": "string",
      "enum": ["verified", "partially_verified", "unverified", "deprecated"],
      "description": "Official verification state."
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Verification notes or license nuances."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string" }
      },
      "description": "List of [label, url] pairs establishing primary-source provenance."
    },
    "domain": {
      "type": ["string", "null"],
      "description": "Primary normalized hostname."
    },
    "provider": {
      "type": ["string", "null"],
      "description": "Publisher, vendor, or owning organization."
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^(tool|model|developer_resource):[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Namespaced unique identifier across all registries."
    }
  }
}
